---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import Prose from '../../components/Prose.astro';
import { readingTime } from '../../utils/reading-time';
import { isVisible } from '../../utils/drafts';
import { formatLong, isoDate } from '../../utils/format-date';

export async function getStaticPaths() {
  const posts = await getCollection('writing', isVisible);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const changelog = [...(post.data.changelog ?? [])].sort((a, b) => b.date.getTime() - a.date.getTime());
const updated = changelog[0]?.date;
---

<Layout title={`${post.data.title} — bellsoftware`} description={post.data.description} active="writing">
  <article>
    <a href="/writing" class="back-link">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Writing
    </a>

    {post.data.draft && (
      <p class="draft-banner" role="note">
        Draft preview. This post isn't published yet.
      </p>
    )}

    <ArticleHeader title={post.data.title} pubDate={post.data.pubDate} readingTime={minutes} updated={updated} />

    <Prose>
      <Content />
    </Prose>

    {changelog.length > 0 && (
      <section id="changelog" class="changelog" aria-labelledby="changelog-heading">
        <h2 id="changelog-heading">Changelog</h2>
        <ul>
          {changelog.map((entry) => (
            <li>
              <time datetime={isoDate(entry.date)}>{formatLong(entry.date)}</time>
              <span>{entry.note}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="article-end">
      <a href="/writing">More writing</a>
      <span>—</span>
    </div>
  </article>
</Layout>

<style>
  article {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-16) 0 var(--space-24);
  }

  @media (max-width: 640px) {
    article {
      padding: var(--space-12) 0 var(--space-16);
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--muted);
    margin-bottom: var(--space-12);
    letter-spacing: 0.02em;
  }

  .back-link svg {
    transition: transform 160ms ease;
  }

  .back-link:hover {
    color: var(--fg);
  }

  .back-link:hover svg {
    transform: translateX(-3px);
  }

  .draft-banner {
    font-size: var(--text-xs);
    color: var(--fg-strong);
    background: var(--code-bg);
    border-left: 3px solid var(--accent);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-8);
    letter-spacing: 0.01em;
  }

  .changelog {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    font-size: var(--text-xs);
    color: var(--muted);
    scroll-margin-top: var(--space-8);
  }

  .changelog h2 {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--fg-strong);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-4);
  }

  .changelog ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .changelog li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    line-height: 1.5;
  }

  .changelog time {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .changelog li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .changelog + .article-end {
    margin-top: var(--space-8);
  }

  .article-end {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .article-end a {
    color: var(--muted);
  }

  .article-end a:hover {
    color: var(--fg);
  }
</style>
